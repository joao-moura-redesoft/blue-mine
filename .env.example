# Exemplo de arquivo .env
# Copie este arquivo para .env e altere os valores conforme necessário.

# =============================================================================
# Endereços dos sistemas corporativos
# =============================================================================
# Preenchem — e TRAVAM — os campos de endereço na interface, para que ninguém
# precise digitar a URL do Redmine/Nextcloud/Zimbra na primeira execução.
#
# Estas são lidas na hora do BUILD (`vite build` lê este arquivo via `envDir`)
# e ficam embutidas no bluemine.exe. Editar o .env depois de gerar o executável
# não muda nada: é preciso rodar o build de novo.
#
# Um campo só trava quando a variável correspondente está definida. Deixe em
# branco/comentada para manter o campo editável pelo usuário.
#
# ATENÇÃO: tudo que começa com VITE_ vai para dentro do bundle e é legível por
# qualquer um que abra o .exe. Nunca coloque segredo aqui — só endereço.

# URL base do Redmine (trava o campo da tela de login).
VITE_REDMINE_URL=https://redmine.b2click.com

# URL do Nextcloud — usada por Talk, Drive e Notas.
VITE_NEXTCLOUD_URL=https://drive.b2click.com

# Host do Zimbra: só o domínio, SEM https://
# Também é lido pelo servidor (substitui o antigo ZIMBRA_HOST, ainda aceito).
VITE_ZIMBRA_HOST=email.redesoft.org

# Domínio do servidor Jitsi (videochamadas).
VITE_JITSI_DOMAIN=meet.b2click.com

# Host do DokuWiki: só o domínio. O frontend usa para exibir e montar os links
# "abrir no DokuWiki"; o servidor usa para falar com a wiki.
# DOKUWIKI_HOST (sem prefixo) ainda é aceito pelo servidor, por compatibilidade.
VITE_DOKUWIKI_HOST=wiki.redesoft.com.br

# =============================================================================
# Rede / segurança
# =============================================================================
# Para permitir domínios internos que normalmente são bloqueados pela proteção SSRF.
# Aceita múltiplos valores separados por vírgula.
SSRF_WHITELIST=drive.b2click.com

# Para desabilitar totalmente a proteção SSRF para a rede local (use com cautela).
# ALLOW_LOCAL_SSRF=1
